rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isBootstrapAdmin() {
      return isAuthenticated() && 
             request.auth.token.email.lower() == "pwhite.xm@gmail.com";
    }
    
    function isAdmin() {
      return isAuthenticated() && (isBootstrapAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'ADMIN'));
    }
    
    function hasRole(roles) {
      return isAuthenticated();
    }

    function isValidIssue(data) {
      return true;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['issueId', 'userId', 'content', 'createdAt']) &&
             data.issueId is string &&
             data.userId == request.auth.uid &&
             data.content is string && data.content.size() > 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) && (
        request.resource.data.role == 'REPORTER' || 
        (isBootstrapAdmin() && request.resource.data.role == 'ADMIN')
      );
      allow update: if isAuthenticated() && (
        isOwner(userId) || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /issues/{issueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasRole(['ADMIN', 'REPORTER', 'ASSIGNEE']) && isValidIssue(request.resource.data);
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.reporterId == request.auth.uid || 
        resource.data.assigneeId == request.auth.uid
      ) && isValidIssue(request.resource.data);
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidComment(request.resource.data);
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Usually created via backend or client-side logic
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated(); // Allow users to create notifications for others
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /attachments/{attachmentId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
