rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /issues/{allPaths=**} {
      // Allow read so issue attachments and preview thumbnails load cleanly
      allow read: if true;
      // Require authenticated user for write operations with size safety limit
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
